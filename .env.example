BILLING_PROVIDER=mercado_pago

MP_ENV=test
MP_ACCESS_TOKEN_TEST=
MP_ACCESS_TOKEN_PROD=
MP_WEBHOOK_URL=https://dosdoisapp.com.br/apiDDv1/subs/mpWebHook

# IDs dos planos de assinatura criados no Mercado Pago para o ambiente de teste.
# Use os codigos das ofertas em planos_ofertas.codigo.
MP_PLAN_ID_PREMIUM_MONTHLY_TEST=
MP_PLAN_ID_PREMIUM_YEARLY_TEST=
MP_PLAN_ID_FOUNDERS_YEARLY_90_TEST=

# Opcional: mantenha os IDs produtivos fora do banco durante testes locais.
MP_PLAN_ID_PREMIUM_MONTHLY_PROD=
MP_PLAN_ID_PREMIUM_YEARLY_PROD=
MP_PLAN_ID_FOUNDERS_YEARLY_90_PROD=

# Provedor alternativo de assinaturas. Mantenha BILLING_PROVIDER=mercado_pago
# ate o fluxo Asaas estar implementado e validado ponta a ponta.
ASAAS_ENV=sandbox
ASAAS_API_KEY_SANDBOX=
ASAAS_API_KEY_PROD=
ASAAS_WEBHOOK_TOKEN=
ASAAS_WEBHOOK_URL=https://dosdoisapp.com.br/apiDDv1/subs/asaasWebHook
ASAAS_CHECKOUT_SUCCESS_URL=https://web.dosdoisapp.com.br/conta?assinatura=sucesso
ASAAS_CHECKOUT_CANCEL_URL=https://web.dosdoisapp.com.br/conta?assinatura=cancelada
ASAAS_CHECKOUT_EXPIRED_URL=https://web.dosdoisapp.com.br/conta?assinatura=expirada
